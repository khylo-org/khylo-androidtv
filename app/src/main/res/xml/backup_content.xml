<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- authentication_store.json holds the sign-in keys, so it is never backed up or transferred: after a restore, sign in again -->

    <!-- UserPreferences -->
    <include
        domain="sharedpref"
        path="org.khylo.tv.core_preferences" />
    <include
        domain="sharedpref"
        path="org.khylo.tv.core.debug_preferences" />
    <!-- SystemPreferences -->
    <include
        domain="sharedpref"
        path="systemprefs" />
    <!-- AuthenticationPreferences -->
    <include
        domain="sharedpref"
        path="AuthenticationPreferences" />
</full-backup-content>
